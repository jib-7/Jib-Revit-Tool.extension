<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Line Colour" Width="360" Height="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
  <StackPanel Margin="14">
    <Border x:Name="Swatch" Height="46" BorderBrush="#FF888888" BorderThickness="1" CornerRadius="3" Margin="0,0,0,10"/>
    <Grid Margin="0,2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
      <TextBlock Text="R" VerticalAlignment="Center"/>
      <Slider x:Name="SliderR" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="slider_changed"/>
      <TextBlock x:Name="ValR" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Grid Margin="0,2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
      <TextBlock Text="G" VerticalAlignment="Center"/>
      <Slider x:Name="SliderG" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="slider_changed"/>
      <TextBlock x:Name="ValG" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Grid Margin="0,2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
      <TextBlock Text="B" VerticalAlignment="Center"/>
      <Slider x:Name="SliderB" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="slider_changed"/>
      <TextBlock x:Name="ValB" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,8">
      <TextBlock Text="HEX" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="HexBox" Width="110" Padding="3" TextChanged="hex_changed"/>
    </StackPanel>
    <TextBlock Text="Quick colours" Foreground="#FF666666" Margin="0,4,0,2"/>
    <WrapPanel x:Name="Palette"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" Width="80" Padding="4" Margin="4" IsDefault="True" Click="ok_click"/>
      <Button Content="Cancel" Width="80" Padding="4" Margin="4" IsCancel="True" Click="cancel_click"/>
    </StackPanel>
  </StackPanel>
</Window>
